DB_BACKEND=postgres
DB_NAME=mercado
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
DB_TIMEZONE=America/Sao_Paulo
DB_APP_NAME=mercado-api

DB_CONN_MAX_AGE=120
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=12000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=30000

DB_POOL_ENABLED=true
DB_POOL_MIN_SIZE=4
DB_POOL_MAX_SIZE=40
DB_POOL_TIMEOUT=30
